#

UBOOT_FW_ENV_MMC_START:fsimx93 = "0x003cc800"
UBOOT_FW_ENV_MMC_SIZE:fsimx93  = "0x00004000"
UBOOT_FW_ENV_MMC_REDUNDANT_START:fsimx93 = "0x003cc800"
UBOOT_FW_ENV_MMC_REDUNDANT_SIZE:fsimx93  = "0x00004000"

#
# fsimx91 machine override
#

UBOOT_FW_ENV_MMC_START:fsimx91 = "0x003cc800"
UBOOT_FW_ENV_MMC_SIZE:fsimx91  = "0x00040000"
UBOOT_FW_ENV_MMC_REDUNDANT_START:fsimx91 = "0x003cc800"
UBOOT_FW_ENV_MMC_REDUNDANT_SIZE:fsimx91  = "0x00040000"

#
# fsimx8ulp machine override
#

UBOOT_FW_ENV_MMC_START:fsimx8ulp = "0x003cc800"
UBOOT_FW_ENV_MMC_SIZE:fsimx8ulp  = "0x00004000"
UBOOT_FW_ENV_MMC_REDUNDANT_START:fsimx8ulp = "0x003cc800"
UBOOT_FW_ENV_MMC_REDUNDANT_SIZE:fsimx8ulp  = "0x00004000"
