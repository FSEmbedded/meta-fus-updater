#
# default fallback values
#

UBOOT_FW_ENV_MMC_START ?= "0x003cc800"
UBOOT_FW_ENV_MMC_SIZE  ?= "0x00004000"
UBOOT_FW_ENV_MMC_REDUNDANT_START ?= "0x003cc800"
UBOOT_FW_ENV_MMC_REDUNDANT_SIZE  ?= "0x00004000"

UBOOT_FW_ENV_NAND_START ?= "0x00000000"
UBOOT_FW_ENV_NAND_SIZE  ?= "0x00004000"
UBOOT_FW_ENV_NAND_REDUNDANT_START ?= "0x00040000"
UBOOT_FW_ENV_NAND_REDUNDANT_SIZE  ?= "0x00004000"
UBOOT_FW_ENV_NAND_ERASE_SIZE  ?= "0x00020000"


#
# fsimx8mm machine override
#
UBOOT_FW_ENV_MMC_START:fsimx8mm = "0x00000000"
UBOOT_FW_ENV_MMC_SIZE:fsimx8mm  = "0x00004000"
UBOOT_FW_ENV_MMC_REDUNDANT_START:fsimx8mm = "0x00000000"
UBOOT_FW_ENV_MMC_REDUNDANT_SIZE:fsimx8mm  = "0x00004000"

UBOOT_FW_ENV_NAND_START:fsimx8mm = "0x00000000"
# use 128KiB env. and 128KiB for bad block reserve(BBR)
UBOOT_FW_ENV_NAND_SIZE:fsimx8mm  = "0x00004000"
UBOOT_FW_ENV_NAND_REDUNDANT_START:fsimx8mm = "0x00040000"
# use 128KiB env. and 128KiB for bad block reserve(BBR)
UBOOT_FW_ENV_NAND_REDUNDANT_SIZE:fsimx8mm  = "0x00004000"
UBOOT_FW_ENV_NAND_ERASE_SIZE:fsimx8mm = "0x00020000"

#
# fsimx8mp machine override
#

UBOOT_FW_ENV_MMC_START:fsimx8mp = "0x00040000"
UBOOT_FW_ENV_MMC_SIZE:fsimx8mp  = "0x00004000"
UBOOT_FW_ENV_MMC_REDUNDANT_START:fsimx8mp = "0x00040000"
UBOOT_FW_ENV_MMC_REDUNDANT_SIZE:fsimx8mp  = "0x00004000"

